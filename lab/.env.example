# Copia este archivo como lab\.env y pon tu clave. lab/.env está en .gitignore: nunca se sube.
#
# Clave gratuita de Google AI Studio (sin tarjeta): https://aistudio.google.com/apikey
# En la UE, Google aplica también al plan gratuito las condiciones de datos del de pago:
# no usa lo que envías para mejorar sus productos.
GEMINI_API_KEY=

# Modelo A: preetiqueta y es el que se mide en la línea base. Modelo B: otro para comparar, distinto
# del A (docs/10, regla 3). Por ahora vacío: gemini-4-hydrogen estaba saturado (22-11-2026).
MODELO_A=gemini-3.6-flash
MODELO_B=

# Sin gasto: los scripts solo aceptan modelos con plan gratuito (lista en lab/comun.py) y se niegan a
# llamar con PLAN_GRATUITO=0. No actives la facturación en Google AI Studio: sin ella, Google no puede
# cobrar nada; si se acaba la cuota del día, la API responde 429 y el script para hasta mañana.
# Los precios son los del plan de pago, en dólares por millón de tokens (página de precios de Google,
# 18-11-2026): solo se apunta lo que costaría, como dato para decidir la Fase 4.
PLAN_GRATUITO=1
PRECIO_A_ENTRADA=0.75
PRECIO_A_SALIDA=3.75
PRECIO_B_ENTRADA=1.50
PRECIO_B_SALIDA=7.50

# Para que el resultado se pueda repetir (estos modelos ya no admiten temperatura).
NIVEL_RAZONAMIENTO=medium
SEMILLA=7

# El plan gratuito permite unas 5 peticiones por minuto en los modelos Flash.
SEGUNDOS_ENTRE_LLAMADAS=13
# low, medium o high: más alta, más detalle de la cabeza del palo y más tokens.
RESOLUCION_IMAGEN=high
