# Copia este archivo como lab\.env y pon tu clave. lab/.env está en .gitignore: nunca se sube.
#
# Clave gratuita de Google AI Studio (sin tarjeta): https://aistudio.google.com/apikey
# En la UE, Google aplica también al plan gratuito las condiciones de datos del de pago:
# no usa lo que envías para mejorar sus productos.
GEMINI_API_KEY=

# Modelo A: preetiqueta para ahorrarte trabajo. Modelo B: el que se evalúa en la Fase 2.
# Tienen que ser distintos (docs/10, regla 3).
MODELO_A=gemini-3.8-flash
MODELO_B=gemini-4-hydrogen

# 1 = plan gratuito (coste real 0). Los precios son los del plan de pago, en dólares por millón de
# tokens (página de precios de Google, 18-11-2026): se apunta lo que costaría, para decidir la Fase 4.
# gemini-3.8-flash sube a 1.50 / 7.50 desde el 1-1-2027.
PLAN_GRATUITO=1
PRECIO_A_ENTRADA=0.75
PRECIO_A_SALIDA=3.75
PRECIO_B_ENTRADA=1.50
PRECIO_B_SALIDA=7.50

# Para que el resultado se pueda repetir (estos modelos ya no admiten temperatura).
NIVEL_RAZONAMIENTO=medium
SEMILLA=7

# El plan gratuito permite unas 5 peticiones por minuto en los modelos Flash.
SEGUNDOS_ENTRE_LLAMADAS=13
# low, medium o high: más alta, más detalle de la cabeza del palo y más tokens.
RESOLUCION_IMAGEN=high
